{
  "name": "style-detective",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Hover over any HTML element to inspect its computed CSS in a floating panel.",
  "license": "GPL-2.0",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:field": "tsx audits/field-audit.ts"
  },
  "overrides": {
    "rollup": "^4.60.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true,
    "esbuild": true
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.4",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "zod": "^4.6.5"
  }
}
